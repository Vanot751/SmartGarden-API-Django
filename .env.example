# SmartGarden API - Variables de Entorno de Ejemplo
# Renombrar a .env y configurar los valores según tu entorno local o producción

# Configuración de Django
DJANGO_SECRET_KEY=django-insecure-smartgarden-dev-secret-key-change-in-production
DJANGO_DEBUG=True

# Base de Datos PostgreSQL (ej. Supabase o PostgreSQL Local)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# API Botánica Externa (Perenual)
PLANT_API_BASE_URL=https://perenual.com/api/species-list
PLANT_API_KEY=tu_api_key_perenual_aqui

# Inferencia de Inteligencia Artificial (GroqCloud LLM para FloraBot)
GROQ_API_KEY=gsk_tu_api_key_de_groq_aqui
